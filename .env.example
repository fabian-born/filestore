# Connection details for your existing MinIO server
MINIO_ENDPOINT=minio.example.com
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme

# Bucket name is configured via the in-app Settings menu (defaults to "webtools").
# MINIO_BUCKET is only used to seed that setting on first startup.

# Login credentials for the web UI
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# Random string used to sign session cookies (generate e.g. with `openssl rand -hex 32`)
SESSION_SECRET=changeme

# Set to true once the app is served over HTTPS
COOKIE_SECURE=false

# Number of reverse proxies in front of the backend (default 1 = the bundled
# nginx). Set to 2 if you run another proxy (Traefik, Caddy, ...) in front of
# it, so login rate limiting sees real client IPs.
# TRUST_PROXY=1
